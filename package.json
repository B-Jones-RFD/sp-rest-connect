{
  "name": "@b-jones-rfd/sp-rest-connect",
  "version": "3.0.0",
  "description": "Use SharePoint REST Services to interact with lists and document libraries",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "tsc",
    "ci": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "pnpm run build && pnpm publish -r --no-git-checks"
  },
  "keywords": [
    "sharepoint",
    "sharepoint-rest",
    "rest",
    "odata",
    "ntlm",
    "ntlmv2",
    "on-premise",
    "list",
    "document-library",
    "nodejs"
  ],
  "author": "B-Jones-RFD",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Jones-RFD/sp-rest-connect.git"
  },
  "homepage": "https://github.com/B-Jones-RFD/sp-rest-connect#readme",
  "bugs": {
    "url": "https://github.com/B-Jones-RFD/sp-rest-connect/issues"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "tsup": "^6.6.3",
    "typescript": "^4.9.5",
    "vitest": "^0.28.5"
  }
}
