{
  "name": "@b-jones-rfd/sp-rest-connect",
  "version": "4.0.1",
  "description": "Use SharePoint REST Services to interact with lists and document libraries",
  "private": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vitest",
    "test": "vitest run",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "tsc",
    "ci": "pnpm run lint && pnpm run test && pnpm run build && pnpm run check:package",
    "release": "pnpm run build && changeset publish",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "keywords": [
    "sharepoint",
    "sharepoint-rest",
    "rest",
    "odata",
    "ntlm",
    "ntlmv2",
    "on-premise",
    "list",
    "document-library",
    "nodejs"
  ],
  "author": "B-Jones-RFD",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Jones-RFD/sp-rest-connect.git"
  },
  "homepage": "https://github.com/B-Jones-RFD/sp-rest-connect#readme",
  "bugs": {
    "url": "https://github.com/B-Jones-RFD/sp-rest-connect/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
